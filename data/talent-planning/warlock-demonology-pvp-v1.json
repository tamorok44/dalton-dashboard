    },
    {
      "talentId": 105900,
      "reason": "Dämonische Opferung als Voraussetzung freischalten; vor Dämonischem Pakt beendet das Beschwören eines Dämons den Bonus.",
      "count": 1
    },
    {
      "talentId": 105898,
      "reason": "Beschwörungen schneller und günstiger machen.",
      "count": 2
    },
    {
      "talentId": 105896,
      "reason": "Sengender Schmerz erzeugt weniger Bedrohung und markiert das Ziel für eine begrenzte Anzahl zusätzlicher Dämonentreffer. Zusatzschaden ist je nach Dämon Feuer oder Schatten; nur Schatten erzeugt hohe Bedrohung. Keine feste Schadenszahl oder garantierte Ausnutzung.",
      "count": 2
    },
    {
      "talentId": 105892,
      "reason": "Seelenverbindung verteilt einen Teil des eigenen erlittenen Schadens auf den aktiven Dämon und unterstützt beider Schaden; Gesundheit beider Partner beachten.",
      "count": 1
    },
    {
      "talentId": 105895,
      "reason": "Fel Domination für schnellere und günstigigere nächste Dämonenbeschwörung in einer Notfallsituation; nicht als ständig verfügbar annehmen.",
      "count": 1
    },
    {
      "talentId": 105893,
      "reason": "Dämonisches Wissen erhöht bei aktivem Dämon den eigenen und dessen Zauberschaden abhängig von der eigenen Stufe.",
      "count": 3
    },
    {
      "talentId": 105891,
      "reason": "Meister der Dämonologie: vom aktiven Dämontyp abhängige Schadens- oder Schutzboni.",
      "count": 5
    },
    {
      "talentId": 105890,
      "reason": "Dämonischer Pakt erlaubt den Opferungsbonus mit einem anderen aktiven Dämon; erneutes Beschwören desselben Dämontyps beendet ihn. Persönlicher Effekt, kein pauschaler Gruppenbuff.",
      "count": 1
    },
    {
      "talentId": 105894,
      "reason": "Improved Felhunter verbessert bestimmte Fähigkeiten des Teufelsjägers einschließlich seiner Unterbrechung; nur mit diesem Begleiter nutzbar.",
      "count": 2
    },
    {
      "talentId": 105924,
      "reason": "Verderbnis sofort wirkbar machen.",
      "count": 5
    },
    {
      "talentId": 105888,
      "reason": "Zauberzeiten direkter Schadenszauber verringern.",
      "count": 5
    },
    {
